{
  "name": "dsh-widgets",
  "version": "0.2.0",
  "description": "Small, independent widgets for the DeepSeek Harness UI: a branch/worktree target picker that defaults to the current branch, opt-in branch folders in the workspace tree, a Shift+Tab /plan toggle, drag-and-drop and in-place editing of the message queue, and an Improve prompt button with its own model, thinking switch and thinking effort.",
  "icon": "./assets/icon.svg",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "widgets",
    "worktree",
    "git-branch",
    "plan-mode",
    "queue",
    "prompt",
    "reasoning-effort"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/web/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "assets/icon.svg"
  ],
  "scripts": {
    "build": "npm run build:host && npm run build:web",
    "build:host": "tsc -p tsconfig.build.json",
    "build:web": "node build.web.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.web.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "e2e": "npm run build && node e2e/widgets.spec.mjs",
    "clean": "rm -rf dist"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-shortcuts"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ImaginingMaker/dsh-widgets.git"
  },
  "homepage": "https://github.com/ImaginingMaker/dsh-widgets#readme",
  "bugs": {
    "url": "https://github.com/ImaginingMaker/dsh-widgets/issues"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "^0.2.2-rc.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.56.0",
    "typescript": "^7.0.2"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts"
}
